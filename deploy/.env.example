# Copiar a deploy/.env y completar. Este archivo (.env) NO se sube a git.

# --- Base de datos ----------------------------------------------------------
# Opcion A (por defecto): PostgreSQL incluido en el mismo servidor.
COMPOSE_PROFILES=local-db
POSTGRES_PASSWORD=cambiar_por_una_clave_larga
DATABASE_URL=postgresql://case_uml:cambiar_por_una_clave_larga@db:5432/case_uml?schema=public
#   (la clave de DATABASE_URL debe ser la misma que POSTGRES_PASSWORD;
#    usar solo letras y numeros para no tener que codificarla en la URL)
#
# Opcion B: Amazon RDS. Borrar la linea COMPOSE_PROFILES y usar el endpoint de RDS.
# RDS (PostgreSQL 15+) exige SSL por defecto: dejar "sslmode=require" al final.
# DATABASE_URL=postgresql://USUARIO:CLAVE@mi-base.xxxxxx.us-east-1.rds.amazonaws.com:5432/case_uml?schema=public&sslmode=require

# --- Seguridad --------------------------------------------------------------
# Secreto para firmar las sesiones (JWT). Obligatorio. Generarlo con:
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- IA ---------------------------------------------------------------------
GEMINI_API_KEY=

# --- Acceso publico ---------------------------------------------------------
# Sin dominio: SITE_ADDRESS=:80 y PUBLIC_URL=http://IP_PUBLICA
# Con dominio (HTTPS automatico): SITE_ADDRESS=midominio.com y PUBLIC_URL=https://midominio.com
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
