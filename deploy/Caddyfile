# Punto de entrada publico de CASE_UML.
#
# SITE_ADDRESS (en deploy/.env):
#   :80             -> solo HTTP, accediendo por la IP publica del servidor.
#   midominio.com   -> Caddy obtiene y renueva solo el certificado HTTPS
#                      (Let's Encrypt). El dominio debe apuntar a la IP del
#                      servidor y los puertos 80 y 443 deben estar abiertos.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API REST y WebSocket (Socket.IO) van al backend; al ser el mismo
	# dominio no hace falta CORS y los WebSocket pasan sin configuracion extra.
	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy backend:4000
	}

	# El resto es la SPA: cualquier ruta del frontend (/projects/...) sirve
	# index.html y React Router resuelve la pantalla.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
